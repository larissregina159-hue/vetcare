generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  telefone String?
  senha    String
  tipo     String @default("CLIENTE")
}

model Cliente {
  id       Int    @id @default(autoincrement())
  nome     String
  cpf      String @unique
  email    String @unique
  telefone String?
  endereco String?

  animais  Animal[]
}

model Animal {
  id        Int     @id @default(autoincrement())
  nome      String
  especie   String
  raca      String?
  idade     Int?
  peso      Float?

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  consultas   Consulta[]
  prontuarios Prontuario[]
}

model Veterinario {
  id            Int     @id @default(autoincrement())
  nome          String
  crmv          String  @unique
  especialidade String?
  telefone      String?
  email         String? @unique

  consultas   Consulta[]
  prontuarios Prontuario[]
}

model Consulta {
  id            Int      @id @default(autoincrement())
  animalId      Int
  veterinarioId Int
  data          DateTime
  motivo        String
  status        String   @default("AGENDADA")

  animal       Animal      @relation(fields: [animalId], references: [id])
  veterinario  Veterinario @relation(fields: [veterinarioId], references: [id])
}

model Prontuario {
  id            Int      @id @default(autoincrement())
  animalId      Int
  veterinarioId Int
  data          DateTime
  diagnostico   String
  tratamento    String
  observacoes   String?

  animal       Animal      @relation(fields: [animalId], references: [id])
  veterinario  Veterinario @relation(fields: [veterinarioId], references: [id])
}
